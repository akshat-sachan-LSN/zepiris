# Copy to .env and adjust. All app settings use prefix ZEPIRIS_ (see config.py).

ZEPIRIS_API_HOST=0.0.0.0
ZEPIRIS_API_PORT=8000

ZEPIRIS_MINIO_ENDPOINT=localhost:9002
ZEPIRIS_MINIO_ACCESS_KEY=minioadmin
ZEPIRIS_MINIO_SECRET_KEY=minioadmin
ZEPIRIS_MINIO_BUCKET=zepiris
ZEPIRIS_MINIO_SECURE=false

ZEPIRIS_MILVUS_HOST=localhost
ZEPIRIS_MILVUS_PORT=19530
ZEPIRIS_MILVUS_COLLECTION=zepiris_faces
ZEPIRIS_MILVUS_EMBEDDING_DIM=512
ZEPIRIS_MILVUS_SEARCH_THRESHOLD=0.5

# Required: ML inference service (see docker-compose). The API forwards both
# images as raw bytes to POST /v1/face/match in one call and gets back the score.
ZEPIRIS_ML_INFERENCE_SERVICE_URL=http://localhost:8001

# Throughput — see docs/PERFORMANCE.md
# "remote" (default) keeps the API and models independently scalable; "local"
# loads the models into the API process, removing the HTTP hop entirely.
ZEPIRIS_MATCH_MODE=remote
# Connection pools must cover peak in-flight requests; httpx keeps only 20
# connections alive by default.
ZEPIRIS_ML_MAX_CONNECTIONS=200
ZEPIRIS_S3_MAX_CONNECTIONS=200
# The API is I/O-bound (fetch images, await the ML service); CPU cost is in the
# ML service, so a couple of workers saturate it.
ZEPIRIS_API_WORKERS=2
# Admission control: in-flight requests per worker above which uvicorn answers
# 503 immediately rather than queueing. 0 = unlimited. This is the only knob that
# bounds end-to-end latency — the ML service's inference limiter sheds only what
# reaches its handler, and under overload the queue forms in the connection
# backlog instead, where nothing times out. Size from the latency you accept:
# queue delay is in-flight / throughput.
ZEPIRIS_API_LIMIT_CONCURRENCY=0
ZEPIRIS_THREAD_POOL_SIZE=64
# Per-request access logging. ~13 GB/day at 1000 req/s, duplicating what the
# load balancer already records with real retention. Off in production.
ZEPIRIS_ACCESS_LOG=false

# ML Inference Microservice (separate container, env prefix ML_SERVICE_)
# See zepiris/ml_inference/app.py
ML_SERVICE_HOST=0.0.0.0
ML_SERVICE_PORT=8001
ML_SERVICE_ML_DEVICE=cpu

ML_SERVICE_NSFW_MODEL_SOURCE=local
ML_SERVICE_NSFW_HF_REPO_ID=
ML_SERVICE_NSFW_HF_MODEL_FILE=nsfw_model.pth
ML_SERVICE_NSFW_LOCAL_MODEL_PATH=/app/models/nsfw_model.pth
ML_SERVICE_NSFW_THRESHOLD=0.5

# Liveness engine: "onnx" = MiniFASNet-V2 (Silent-Face, recommended), "mobilenet" = legacy.
ML_SERVICE_SPOOF_ENGINE=onnx
# Two-model ensemble (V2 @2.7x + V1SE @4.0x). Paths auto-resolve to ./models
# if the container path is absent. The second is optional (single-model if missing).
ML_SERVICE_SPOOF_ONNX_MODEL_PATH=/app/models/minifasnet_v2_yakhyo.onnx
ML_SERVICE_SPOOF_ONNX_MODEL_PATH_2=/app/models/minifasnet_v1se_yakhyo.onnx
# prob_live (class 1 = real, averaged over the ensemble) must exceed this.
ML_SERVICE_SPOOF_ONNX_LIVE_THRESHOLD=0.4

# --- legacy MobileNetV3 spoof model (only used when SPOOF_ENGINE=mobilenet) ---
ML_SERVICE_SPOOF_MODEL_SOURCE=local
ML_SERVICE_SPOOF_HF_REPO_ID=
ML_SERVICE_SPOOF_HF_MODEL_FILE=spoof_model.pth
ML_SERVICE_SPOOF_LOCAL_MODEL_PATH=/app/models/spoof_model.pth
# prob_live must exceed this for the model to vote "live". Raised to 0.7 to
# reject borderline phone/screen replays. Lower if too many real faces fail.
ML_SERVICE_SPOOF_THRESHOLD=0.7
# Passive moiré/glare screen-replay detector (no model download).
ML_SERVICE_SPOOF_SCREEN_DETECTION_ENABLED=true
# replay_score above this flags a recaptured screen. Lower = stricter.
ML_SERVICE_SPOOF_SCREEN_THRESHOLD=0.5

ML_SERVICE_BLUR_MODEL_SOURCE=local
ML_SERVICE_BLUR_HF_REPO_ID=
ML_SERVICE_BLUR_HF_MODEL_FILE=blur_model.pth
ML_SERVICE_BLUR_LOCAL_MODEL_PATH=/app/models/blur_model.pth
ML_SERVICE_BLUR_THRESHOLD=0.5

ML_SERVICE_FACE_EMBEDDING_DIM=512
ML_SERVICE_FACE_DETECTION_WIDTH=512
ML_SERVICE_FACE_DETECTION_HEIGHT=512
ML_SERVICE_FACE_AREA_THRESHOLD=0.01
# Retry detection on a reflect-padded copy when a frame-filling face is missed.
ML_SERVICE_FACE_ENABLE_PADDING_RETRY=true
ML_SERVICE_FACE_PADDING_FRACTION=0.25

# Throughput — see docs/PERFORMANCE.md
# Detector/recognizer pairing: "balanced" (default) keeps ResNet50 recognition
# behind a cheaper detector (~3x, thresholds unchanged); "fast" also swaps
# recognition for MobileFaceNet (~13x) and REQUIRES threshold recalibration;
# "accurate" is stock buffalo_l.
ML_SERVICE_FACE_TIER=balanced
# One core per inference; parallelism comes from concurrent requests. Per-
# inference fan-out oversubscribes the CPU under load and collapses throughput.
ML_SERVICE_FACE_INTRA_OP_THREADS=1
ML_SERVICE_FACE_INTER_OP_THREADS=1
# Downscale oversized captures before detection (0 = off). The detector
# letterboxes to the detection size anyway.
ML_SERVICE_FACE_MAX_INPUT_SIDE=1600
# libjpeg subsampled decode: 0 = full decode, 2 = half size, 4 = quarter.
# Cheaper per decode, but measured a net LOSS on a 320px detector: shrinking the
# input made some faces miss the first detection pass, and each miss costs a
# lower-threshold retry plus a 2x upscale retry. Validate throughput AND
# prod_replay verdicts together before enabling.
ML_SERVICE_FACE_JPEG_DECODE_REDUCTION=0
# FP16 models from scripts/convert_fp16.py. Both must be set, or neither applies.
# A path that does not resolve makes the engine fall back to stock FaceAnalysis
# with only a warning, so verify the startup log names the file you expect.
ML_SERVICE_FACE_DET_MODEL_PATH=
ML_SERVICE_FACE_REC_MODEL_PATH=
# Memoize detector output by image content — only useful when one request
# detects the same pixels twice, which the face-match path does not.
ML_SERVICE_FACE_ENABLE_DET_CACHE=false
# Reference-embedding cache: entries of enrolled-selfie embeddings, keyed by
# image content (0 = off). The reference side of a verification is the same bytes
# every time that person is checked, so re-embedding it — about half the cost of
# a match — buys nothing. Content-keyed, so it cannot serve a stale vector.
# 512 float32s is 2 KB, so 4096 entries is ~8 MB.
ML_SERVICE_FACE_REFERENCE_CACHE_SIZE=4096
# Let a request embed its two sides at once when the limiter shows idle cores
# (it stops doing so under load, where fanning out steals throughput from
# everyone to help one caller).
ML_SERVICE_FACE_PARALLEL_PAIR_EMBED=true
ML_SERVICE_FACE_PARALLEL_EMBED_WORKERS=4
# Cap in-flight inferences (0 = CPU count - 1). Past the cap, requests wait
# briefly and are then shed with 503 rather than piling up past the caller's
# timeout — overload costs the doomed requests, not every request.
ML_SERVICE_MAX_CONCURRENT_INFERENCES=0
ML_SERVICE_INFERENCE_QUEUE_TIMEOUT_SECONDS=20
# No per-request access log: this service sits behind the API on localhost, so
# each line duplicates a request already recorded twice upstream.
ML_SERVICE_ACCESS_LOG=false
